<div class="fixed top-4 right-2 z-50 max-w-md mx-auto mt-4 hidden" data-controller="toast">
    <div class="bg-white border border-gray-200 rounded-t-md shadow-sm max-w-md p-4 flex items-center gap-4 flex-row">
        <%= @message %>
        <button
            type="button"
            class="ml-auto text-gray-500 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 rounded-full"
            data-action="click->toast#dismiss">
            <%= helpers.lucide_icon("x", class: "h-5 w-5") %>
        </button>
    </div>
    <div class="h-1 rounded-b-md">
        <div class="h-full <%= @color %> rounded-b-md animate-progress" data-toast-target="progress"></div>
    </div>
</div>
