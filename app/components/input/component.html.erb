<div data-controller="input" class="flex flex-col w-full gap-2">
  <div class="relative">
    <%= input_html %>
    <button
        type="button"
        class="absolute inset-y-0 right-0 pr-3 flex items-center text-sm leading-5 cursor-pointer"
        data-action="input#togglePassword">
       <div>
        <%= helpers.lucide_icon("eye", class: "hidden", data: { input_target: "eye" }) %>
        <%= helpers.lucide_icon("eye-off", class: "block", data: { input_target: "eyeOff" }) %>
       </div>
    </button>
  </div>
  <ul class="hidden text-red-500/50 text-sm px-6 mt-1 border-2 bg-red-500/10 rounded-4xl py-2 " data-input-target="error"></ul>
</div>
