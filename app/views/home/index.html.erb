<div class="min-h-full bg-slate-50 px-6 py-10">
  <section class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-3xl flex-col items-center justify-center text-center">
    <div class="mb-8 flex h-24 w-24 items-center justify-center rounded-3xl bg-white text-brand-600 shadow-sm ring-1 ring-slate-200">
      <%= lucide_icon("message-square", class: "h-12 w-12") %>
    </div>

    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-brand-600">MessageHub</p>
    <h1 class="text-3xl font-bold text-slate-950 sm:text-4xl">Nenhuma conversa selecionada</h1>
    <p class="mt-4 max-w-xl text-base leading-7 text-slate-600">
      Escolha uma conversa na barra lateral para visualizar mensagens, acompanhar o histórico e continuar o atendimento.
    </p>

    <div class="mt-10 grid w-full max-w-2xl gap-3 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-4 text-left shadow-sm">
        <%= lucide_icon("inbox", class: "mb-3 h-5 w-5 text-brand-600") %>
        <p class="text-sm font-semibold text-slate-900">Conversas</p>
        <p class="mt-1 text-sm text-slate-500">Acesse seus chats recentes.</p>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4 text-left shadow-sm">
        <%= lucide_icon("clock-3", class: "mb-3 h-5 w-5 text-brand-600") %>
        <p class="text-sm font-semibold text-slate-900">Histórico</p>
        <p class="mt-1 text-sm text-slate-500">Continue de onde parou.</p>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-4 text-left shadow-sm">
        <%= lucide_icon("send", class: "mb-3 h-5 w-5 text-brand-600") %>
        <p class="text-sm font-semibold text-slate-900">Mensagens</p>
        <p class="mt-1 text-sm text-slate-500">Responda com agilidade.</p>
      </div>
    </div>
  </section>
</div>
