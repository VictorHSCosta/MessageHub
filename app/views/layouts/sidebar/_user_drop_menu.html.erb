<div class="w-full bg-white rounded-md p-2 relative" data-controller="user-dropdown-menu">
    <div class="hidden absolute z-50 right-0 bottom-16 mt-1 w-full bg-white border border-slate-200 rounded-md shadow-lg py-1" data-user-dropdown-menu-target="menu">
        <a href="#" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Settings</a>
        <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100" %>
    </div>
    <div class="flex items-center gap-2 p-2 h-14 rounded-md hover:bg-slate-100 cursor-pointer" data-action="click->user-dropdown-menu#toggle">
        <div class="h-10 w-10 rounded-full bg-slate-300"></div>
        <div class="font-medium truncate" title="<%= current_user.username %>">
            <%= current_user.username %>
        </div>
    </div>
</div>
