<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-app-bg-light dark:bg-app-bg-dark transition-colors duration-300">
  <div class="max-w-md w-full space-y-8 bg-white dark:bg-received-bubble-dark p-10 rounded-3xl shadow-2xl border border-border-light dark:border-border-dark">
    <div>
      <div class="mx-auto h-16 w-16 bg-brand-primary rounded-2xl flex items-center justify-center shadow-lg shadow-brand-primary/30 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-text-primary-light dark:text-text-primary-dark">
        Alterar sua senha
      </h2>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-8 space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-4">
        <div>
          <div class="flex justify-between items-center mb-1">
            <%= f.label :password, "Nova senha", class: "block text-sm font-medium text-text-primary-light/70 dark:text-text-primary-dark/70" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-text-primary-light/40 dark:text-text-primary-dark/40">(mínimo <%= @minimum_password_length %> caracteres)</span>
            <% end %>
          </div>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "••••••••", class: "appearance-none block w-full px-4 py-3 border border-border-light dark:border-border-dark rounded-xl shadow-sm placeholder-text-primary-light/30 dark:placeholder-text-primary-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent bg-app-bg-light/50 dark:bg-app-bg-dark/50 text-text-primary-light dark:text-text-primary-dark sm:text-sm transition-all" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirme a nova senha", class: "block text-sm font-medium text-text-primary-light/70 dark:text-text-primary-dark/70 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "appearance-none block w-full px-4 py-3 border border-border-light dark:border-border-dark rounded-xl shadow-sm placeholder-text-primary-light/30 dark:placeholder-text-primary-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent bg-app-bg-light/50 dark:bg-app-bg-dark/50 text-text-primary-light dark:text-text-primary-dark sm:text-sm transition-all" %>
        </div>
      </div>

      <div>
        <%= f.submit "Alterar senha", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-xl text-white bg-brand-primary hover:bg-brand-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary shadow-lg shadow-brand-primary/30 transition-all active:scale-95" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
