<%= render layout: "devise/shared/auth_shell", locals: { title: "Alterar sua senha", subtitle: "Defina uma nova senha para voltar a acessar sua conta." } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="space-y-5">
      <div>
        <div class="flex justify-between items-center mb-2 ml-1 gap-4">
          <%= f.label :password, "Nova senha", class: "text-sm font-semibold text-slate-700" %>
          <% if @minimum_password_length %>
            <span class="text-xs font-medium text-slate-400">mínimo <%= @minimum_password_length %> caracteres</span>
          <% end %>
        </div>
        <%= render(Input::Component.new(form: f, field: :password, type: "password", autofocus: true, autocomplete: "new-password", placeholder: "••••••••")) %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirme a nova senha", class: "block text-sm font-semibold text-slate-700 mb-2 ml-1" %>
        <%= render(Input::Component.new(form: f, field: :password_confirmation, type: "password", autocomplete: "new-password", placeholder: "••••••••")) %>
      </div>
    </div>

    <%= f.submit "Alterar senha", class: "w-full py-4 px-6 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-2xl shadow-[0_10px_20px_-5px_rgba(107,76,230,0.4)] hover:shadow-[0_15px_25px_-5px_rgba(107,76,230,0.5)] transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
