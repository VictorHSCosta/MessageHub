<%= render layout: "devise/shared/auth_shell", locals: { title: "Reenviar desbloqueio", subtitle: "Informe seu e-mail para receber novas instruções." } do %>
  <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Seu e-mail", class: "block text-sm font-semibold text-slate-700 mb-2 ml-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "block w-full px-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-all duration-200" %>
    </div>

    <%= f.submit "Reenviar instruções", class: "w-full py-4 px-6 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-2xl shadow-[0_10px_20px_-5px_rgba(107,76,230,0.4)] hover:shadow-[0_15px_25px_-5px_rgba(107,76,230,0.5)] transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
