<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-app-bg-light dark:bg-app-bg-dark transition-colors duration-300">
  <div class="max-w-md w-full space-y-8 bg-white dark:bg-received-bubble-dark p-10 rounded-3xl shadow-2xl border border-border-light dark:border-border-dark">
    <div>
      <div class="mx-auto h-16 w-16 bg-brand-primary rounded-2xl flex items-center justify-center shadow-lg shadow-brand-primary/30 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
      </div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-text-primary-light dark:text-text-primary-dark">
        Criar conta
      </h2>
      <p class="mt-2 text-center text-sm text-text-primary-light/60 dark:text-text-primary-dark/60">
        Junte-se ao MessageHub e comece a conversar
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-4">
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-text-primary-light/70 dark:text-text-primary-dark/70 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "appearance-none block w-full px-4 py-3 border border-border-light dark:border-border-dark rounded-xl shadow-sm placeholder-text-primary-light/30 dark:placeholder-text-primary-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent bg-app-bg-light/50 dark:bg-app-bg-dark/50 text-text-primary-light dark:text-text-primary-dark sm:text-sm transition-all" %>
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <%= f.label :password, "Senha", class: "block text-sm font-medium text-text-primary-light/70 dark:text-text-primary-dark/70" %>
            <% if @minimum_password_length %>
              <span class="text-xs text-text-primary-light/40 dark:text-text-primary-dark/40">(mínimo <%= @minimum_password_length %> caracteres)</span>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "appearance-none block w-full px-4 py-3 border border-border-light dark:border-border-dark rounded-xl shadow-sm placeholder-text-primary-light/30 dark:placeholder-text-primary-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent bg-app-bg-light/50 dark:bg-app-bg-dark/50 text-text-primary-light dark:text-text-primary-dark sm:text-sm transition-all" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirme sua senha", class: "block text-sm font-medium text-text-primary-light/70 dark:text-text-primary-dark/70 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "appearance-none block w-full px-4 py-3 border border-border-light dark:border-border-dark rounded-xl shadow-sm placeholder-text-primary-light/30 dark:placeholder-text-primary-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent bg-app-bg-light/50 dark:bg-app-bg-dark/50 text-text-primary-light dark:text-text-primary-dark sm:text-sm transition-all" %>
        </div>
      </div>

      <div>
        <%= f.submit "Criar conta", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-xl text-white bg-brand-primary hover:bg-brand-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary shadow-lg shadow-brand-primary/30 transition-all active:scale-95" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
