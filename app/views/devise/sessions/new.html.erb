<%= render layout: "devise/shared/auth_shell", locals: { title: "Bem-vindo!", subtitle: "Acesse sua conta para continuar." } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
    <div class="space-y-5">
      <div>
        <%= f.label :email, "Endereço de E-mail", class: "block text-sm font-semibold text-slate-700 mb-2 ml-1" %>
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-brand-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206" />
            </svg>
          </div>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "exemplo@hub.com", class: "block w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-all duration-200" %>
        </div>
      </div>

      <div>
        <div class="flex justify-between items-center mb-2 ml-1">
          <%= f.label :password, "Senha", class: "text-sm font-semibold text-slate-700" %>
          <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
            <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors" %>
          <% end %>
        </div>
        <%= render(Input::Component.new(form: f, field: :password, type: "password", autocomplete: "current-password", placeholder: "••••••••")) %>
      </div>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center">
        <%= f.check_box :remember_me, class: "w-5 h-5 text-brand-600 bg-slate-50 border-slate-200 rounded-lg focus:ring-brand-600/20 transition-all cursor-pointer" %>
        <%= f.label :remember_me, "Manter conectado", class: "ml-3 text-sm font-medium text-slate-600 cursor-pointer" %>
      </div>
    <% end %>

    <%= f.submit "Entrar na Conta", class: "w-full py-4 px-6 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-2xl shadow-[0_10px_20px_-5px_rgba(107,76,230,0.4)] hover:shadow-[0_15px_25px_-5px_rgba(107,76,230,0.5)] transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer" %>
  <% end %>

  <div class="mt-10 pt-8 border-t border-slate-100 text-center">
    <p class="text-slate-500 text-sm">
      Não tem uma conta?
      <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
        <%= link_to "Cadastre-se agora", new_registration_path(resource_name), class: "font-bold text-brand-600 hover:underline ml-1" %>
      <% end %>
    </p>
  </div>
<% end %>
