<div class="min-h-screen flex flex-col lg:flex-row bg-white dark:bg-slate-950 font-sans overflow-hidden">
  
  <!-- Left Side: Login Form (50% on large screens) -->
  <div class="w-full lg:w-1/2 flex flex-col justify-center items-center p-8 lg:p-20 bg-white dark:bg-slate-900 z-20">
    <div class="max-w-md w-full">
      <div class="mb-10">
        <div class="lg:hidden mb-6 flex justify-center">
           <h1 class="text-3xl font-black tracking-tight text-brand-600">
            Message<span class="text-slate-400">Hub</span>
          </h1>
        </div>
        <h2 class="text-4xl font-extrabold text-slate-900 dark:text-white mb-3">Bem-vindo!</h2>
        <p class="text-slate-500 dark:text-slate-400 text-lg">Acesse sua conta para continuar.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <div class="space-y-5">
          <div>
            <%= f.label :email, "Endereço de E-mail", class: "block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2 ml-1" %>
            <div class="relative group">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-brand-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206" />
                </svg>
              </div>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "exemplo@hub.com", 
                  class: "block w-full pl-12 pr-4 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-2xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-all duration-200" %>
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-2 ml-1">
              <%= f.label :password, "Senha", class: "text-sm font-semibold text-slate-700 dark:text-slate-300" %>
              <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
                <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors" %>
              <% end %>
            </div>
            <div class="relative group">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 group-focus-within:text-brand-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", 
                  class: "block w-full pl-12 pr-4 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-2xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 transition-all duration-200" %>
            </div>
          </div>
        </div>

        <div class="flex items-center">
          <% if devise_mapping.rememberable? %>
            <%= f.check_box :remember_me, class: "w-5 h-5 text-brand-600 bg-slate-50 border-slate-200 rounded-lg focus:ring-brand-600/20 transition-all cursor-pointer" %>
            <%= f.label :remember_me, "Manter conectado", class: "ml-3 text-sm font-medium text-slate-600 dark:text-slate-400 cursor-pointer" %>
          <% end %>
        </div>

        <div>
          <%= f.submit "Entrar na Conta", class: "w-full py-4 px-6 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-2xl shadow-[0_10px_20px_-5px_rgba(107,76,230,0.4)] hover:shadow-[0_15px_25px_-5px_rgba(107,76,230,0.5)] transform hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-200 cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-10 pt-8 border-t border-slate-100 dark:border-slate-800 text-center">
        <p class="text-slate-500 dark:text-slate-400 text-sm">
          Não tem uma conta? 
          <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
            <%= link_to "Cadastre-se agora", new_registration_path(resource_name), class: "font-bold text-brand-600 hover:underline ml-1" %>
          <% end %>
        </p>
      </div>
    </div>
  </div>

  <!-- Right Side: Illustration & Decoration (50% on large screens) -->
  <div class="hidden lg:flex w-1/2 relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-600 to-blue-600 p-12 flex-col justify-center items-center text-white">
    <!-- Animated background orbs -->
    <div class="absolute -top-[10%] -left-[10%] w-[60%] h-[60%] rounded-full bg-white/10 blur-[100px] animate-pulse"></div>
    <div class="absolute -bottom-[10%] -right-[10%] w-[60%] h-[60%] rounded-full bg-blue-400/20 blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>
    
    <!-- Abstract Pattern Overlay -->
    <div class="absolute inset-0 opacity-10 mix-blend-overlay">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 100 C 20 0 50 0 100 100 Z" fill="currentColor"></path>
      </svg>
    </div>
    
    <div class="relative z-10 flex flex-col items-center text-center">
      <div class="mb-12 transform transition-transform hover:scale-105 duration-500 animate-float">
        <img src="/login.png" alt="MessageHub Illustration" class="w-full max-w-lg drop-shadow-[0_20px_60px_rgba(0,0,0,0.4)]">
      </div>
      <h1 class="text-5xl lg:text-6xl font-black tracking-tighter mb-6">
        Message<span class="text-white/60">Hub</span>
      </h1>
      <p class="text-white/80 text-xl max-w-md leading-relaxed font-medium">
        Conecte-se com o mundo através de uma experiência de chat moderna e segura.
      </p>
    </div>

    <!-- Bottom Features -->
    <div class="absolute bottom-12 left-0 right-0 flex justify-center space-x-8 opacity-40 text-[10px] uppercase tracking-[0.2em] font-black">
      <span class="flex items-center"><span class="w-2 h-2 bg-white rounded-full mr-2"></span>End-to-end</span>
      <span class="flex items-center"><span class="w-2 h-2 bg-white rounded-full mr-2"></span>Cloud Sync</span>
      <span class="flex items-center"><span class="w-2 h-2 bg-white rounded-full mr-2"></span>Open Source</span>
    </div>
  </div>
</div>

<style>
  @keyframes float {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-25px) rotate(1deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }
  .animate-float {
    animation: float 8s ease-in-out infinite;
  }
</style>
