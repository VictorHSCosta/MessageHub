<div class="min-h-screen flex flex-col lg:flex-row bg-white font-sans overflow-hidden">
  <section class="w-full lg:w-1/2 flex flex-col justify-center items-center px-6 py-10 sm:px-8 lg:px-20 bg-white z-20">
    <div class="max-w-md w-full">
      <div class="mb-10">
        <div class="lg:hidden mb-6 flex justify-center">
          <h1 class="text-3xl font-black tracking-tight text-brand-600">
            Message<span class="text-slate-400">Hub</span>
          </h1>
        </div>
        <h2 class="text-4xl font-extrabold text-slate-900 mb-3"><%= title %></h2>
        <% if local_assigns[:subtitle].present? %>
          <p class="text-slate-500 text-lg"><%= subtitle %></p>
        <% end %>
      </div>

      <%= yield %>
    </div>
  </section>

  <section class="hidden lg:flex w-1/2 relative overflow-hidden bg-brand-50 p-12 flex-col justify-center items-center text-slate-900 border-l border-brand-100">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(107,76,230,0.16),transparent_32%),radial-gradient(circle_at_bottom_right,rgba(37,99,235,0.12),transparent_34%)]"></div>

    <div class="relative z-10 flex flex-col items-center text-center">
      <div class="mb-12 transform transition-transform hover:scale-105 duration-500 animate-float">
        <img src="/login.png" alt="MessageHub" class="w-full max-w-lg drop-shadow-[0_20px_50px_rgba(91,57,209,0.22)]">
      </div>
      <h1 class="text-5xl lg:text-6xl font-black tracking-tight mb-6 text-brand-700">
        Message<span class="text-slate-400">Hub</span>
      </h1>
      <p class="text-slate-600 text-xl max-w-md leading-relaxed font-medium">
        Conecte-se com o mundo através de uma experiência de chat moderna e segura.
      </p>
    </div>

    <div class="absolute bottom-12 left-0 right-0 flex justify-center gap-8 text-[10px] uppercase tracking-[0.2em] font-black text-brand-700/50">
      <span class="flex items-center"><span class="w-2 h-2 bg-brand-500 rounded-full mr-2"></span>End-to-end</span>
      <span class="flex items-center"><span class="w-2 h-2 bg-blue-500 rounded-full mr-2"></span>Cloud Sync</span>
      <span class="flex items-center"><span class="w-2 h-2 bg-slate-400 rounded-full mr-2"></span>Open Source</span>
    </div>
  </section>
</div>
