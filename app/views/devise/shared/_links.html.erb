<div class="mt-6 space-y-3 text-center text-sm">
  <%- if controller_name != 'sessions' %>
    <p class="text-text-primary-light/60 dark:text-text-primary-dark/60">
      Já tem uma conta? 
      <%= link_to "Entre aqui", new_session_path(resource_name), class: "text-brand-primary font-semibold hover:underline" %>
    </p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p class="text-text-primary-light/60 dark:text-text-primary-dark/60">
      Não tem conta? 
      <%= link_to "Criar conta", new_registration_path(resource_name), class: "text-brand-primary font-semibold hover:underline" %>
    </p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-text-primary-light/40 dark:text-text-primary-dark/40 hover:text-brand-primary transition-colors" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "Não recebeu instruções de confirmação?", new_confirmation_path(resource_name), class: "text-text-primary-light/40 dark:text-text-primary-dark/40 hover:text-brand-primary transition-colors" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "Não recebeu instruções de desbloqueio?", new_unlock_path(resource_name), class: "text-text-primary-light/40 dark:text-text-primary-dark/40 hover:text-brand-primary transition-colors" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <div class="pt-4 border-t border-border-light dark:border-border-dark mt-4">
      <%- resource_class.omniauth_providers.each do |provider| %>
        <%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "w-full flex justify-center py-2 px-4 border border-border-light dark:border-border-dark rounded-xl shadow-sm text-sm font-medium text-text-primary-light dark:text-text-primary-dark bg-white dark:bg-received-bubble-dark hover:bg-app-bg-light dark:hover:bg-app-bg-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary transition-all mb-2" %>
      <% end %>
    </div>
  <% end %>
</div>
