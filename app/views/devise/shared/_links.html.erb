<div class="mt-10 pt-8 border-t border-slate-100 space-y-3 text-center text-sm">
  <%- if controller_name != 'sessions' %>
    <p class="text-slate-500">
      Já tem uma conta?
      <%= link_to "Entre aqui", new_session_path(resource_name), class: "font-bold text-brand-600 hover:underline ml-1" %>
    </p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p class="text-slate-500">
      Não tem conta?
      <%= link_to "Criar conta", new_registration_path(resource_name), class: "font-bold text-brand-600 hover:underline ml-1" %>
    </p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-slate-400 hover:text-brand-600 transition-colors" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "Não recebeu instruções de confirmação?", new_confirmation_path(resource_name), class: "text-slate-400 hover:text-brand-600 transition-colors" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "Não recebeu instruções de desbloqueio?", new_unlock_path(resource_name), class: "text-slate-400 hover:text-brand-600 transition-colors" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <div class="pt-4 border-t border-slate-100 mt-4">
      <%- resource_class.omniauth_providers.each do |provider| %>
        <%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "w-full flex justify-center py-3 px-4 border border-slate-200 rounded-2xl shadow-sm text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-600/20 transition-all mb-2" %>
      <% end %>
    </div>
  <% end %>
</div>
